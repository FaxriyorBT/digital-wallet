# Copy this file to .env and change the values. Both docker compose and the application read it.

# HMAC key for signing access tokens, at least 32 characters
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Administrator account created on the first start
ADMIN_EMAIL=admin@wallet.local
ADMIN_PASSWORD=ChangeMe123

DB_USERNAME=wallet
DB_PASSWORD=wallet
